# OpenAI (existing)
OPENAI_API_KEY=

# ── Supabase Auth (https://supabase.com/dashboard) ───────────────────────────
# Project URL — use the base URL only (NOT /rest/v1)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Browser-safe key (Dashboard → Connect → Next.js shows sb_publishable_…)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy JWT anon key — optional if publishable key is set
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# JWT Secret (legacy HS256 fallback): Dashboard → Project Settings → API → JWT Secret
# User sessions on newer projects use ES256 + JWKS; the server verifies those automatically.
SUPABASE_JWT_SECRET=your-jwt-secret

# hCaptcha sitekey (public) + optional server secret for app-owned siteverify.
# Dashboard → Authentication → Attack Protection → Enable CAPTCHA protection (hCaptcha).
# For Supabase Auth sign-in/up: put the Secret in the *Supabase* dashboard and pass
# captchaToken from the browser. Do not siteverify that same token in this app first
# (tokens are single-use). Use HCAPTCHA_SECRET_KEY only for app forms / /api/auth/captcha/verify.
# HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
# HCAPTCHA_SECRET_KEY=0x...your-hcaptcha-secret...

# Public URL (production) — used for email confirmation redirects after sign-up
APP_PUBLIC_URL=https://verbum-zu1l.onrender.com

# Comma-separated superadmin emails — full app access + approve memberships, songs, and priests
SUPERADMIN_EMAILS=you@example.com

# Invite-only signup (default on in production / Render). Set 0 for open sign-up in local dev.
# INVITE_ONLY_SIGNUP=1
# Optional contact shown on landing/sign-in when users need access (defaults to first SUPERADMIN_EMAILS)
# INVITE_CONTACT_EMAIL=admin@yourparish.org

# Landing access-request form (POST /api/access-request) — emails admin + requester.
# ACCESS_REQUEST_TO=divinogabriel76@gmail.com
#
# Landing contact form (POST /api/contact) emails every SUPERADMIN_EMAILS address.
# No extra CONTACT_TO needed — uses SUPERADMIN_EMAILS.
# RATE_LIMIT_CONTACT_BURST_MAX=3
# RATE_LIMIT_CONTACT_BURST_WINDOW=900
# RATE_LIMIT_CONTACT_DAY_MAX=8
# RATE_LIMIT_CONTACT_DAY_WINDOW=86400
#
# ── Operator alerts (email + free Telegram) ───────────────────────────────────
# Fired on: new registration, song / priest / parish-rename submissions,
# access requests + contact (Telegram; email already sent separately).
# ADMIN_ALERTS_ENABLED=1
# Optional override for alert emails (defaults to SUPERADMIN_EMAILS):
# ALERT_EMAILS=you@example.com
#
# Telegram (free):
# 1) Message @BotFather → /newbot → copy token
# 2) Start a chat with your bot, then get your chat id (@userinfobot or getUpdates)
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
# Local macOS only if you see CERTIFICATE_VERIFY_FAILED / self-signed chain:
# TELEGRAM_SSL_VERIFY=0
# Test: POST /api/internal/admin-alerts/test  Header X-Cron-Secret: …
#
# ── Brevo transactional email (recommended setup order) ───────────────────────
# 1) Generate API key
#    Brevo → SMTP & API → API keys → Create → copy xkeysib-…
#    BREVO_API_KEY=xkeysib-...
#
# 2) Create sender
#    Brevo → Senders → Add a sender → verify (email or domain).
#    EMAIL_FROM=LiturgyFlow <noreply@yourdomain.com>
#    BREVO_FROM=LiturgyFlow <noreply@yourdomain.com>
#
# 3) Authenticate domain (recommended for inbox delivery)
#    Brevo → Domains → Add domain → add DNS (SPF/DKIM/DMARC) at your registrar.
#
# 4) Connect in this project
#    EMAIL_TRANSPORT=brevo_api
#    (auto = try Brevo API, then Resend, then SMTP)
#    If Brevo “Authorised IPs” is on: add Render outbound IP, or disable IP lock.
#    https://app.brevo.com/security/authorised_ips
#
# 5) Send a test email
#    python scripts/test_brevo_email.py --check
#    python scripts/test_brevo_email.py you@example.com
#    Or: POST /api/internal/email/test  {"to":"you@…"}  Header X-Cron-Secret: …
#
# Logo inside emails (uses APP_PUBLIC_URL by default):
# EMAIL_LOGO_URL=https://your-app.onrender.com/static/brand/email-logo.png
# EMAIL_LOGO_PATH=/static/brand/email-logo.png
#
# 6) Later (optional): contacts / automations / campaigns — NOT needed for app mail.
#
# Optional SMTP fallback (skip if using BREVO_API_KEY only):
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-login@email.com
# SMTP_PASSWORD=your-smtp-key
# SMTP_FROM=LiturgyFlow <noreply@yourdomain.com>
#
# Optional Resend:
# RESEND_API_KEY=
# RESEND_FROM=LiturgyFlow <onboarding@resend.dev>
#
# Weekly reminders (Wed Mass PPTX / Fri choir practice share):
# EMAIL_REMINDERS_ENABLED=1
# CRON_SECRET=long-random-string
# Trigger: POST /api/internal/email-reminders/run  Header: X-Cron-Secret: …
# Or: python scripts/run_email_reminders.py --kind mass_pptx|practice_share|auto
#
# Readings autofetch (once daily via Render cron → web service):
# POST /api/internal/readings/auto-fetch  Header: X-Cron-Secret: …
# Body: {"window":"year","attempts":3,"scope":"missing","alert":true}
# Or: python scripts/run_readings_autofetch.py --window year --dry-run
# Or: python scripts/cron_curl_readings_autofetch.py
# Sweeps every Sunday in the civil year; only missing/unhealthy dates are fetched.
# Emails SUPERADMIN_EMAILS when any Sunday stays critical after 3 tries.
# READINGS_AUTOFETCH_WINDOW=year
# READINGS_AUTOFETCH_YEAR=   # optional; default = current year
# READINGS_AUTOFETCH_ATTEMPTS=3
# READINGS_AUTOFETCH_SUNDAYS=8   # only used when WINDOW=upcoming
# READINGS_AUTOFETCH_SCOPE=missing
# READINGS_AUTOFETCH_ALERT=1
# READINGS_AUTOFETCH_TIMEOUT_S=1800

# AI image generation quota (OpenAI / Gemini poster art)
# Weekly parish/user budget (UTC ISO week). Cache hits do not consume a slot.
IMAGE_GENERATION_WEEKLY_LIMIT=5
# Legacy daily key still read as a fallback when WEEKLY is unset (daily × 7, min 5).
# IMAGE_GENERATION_DAILY_LIMIT=1

# ── Rate limiting & request safety ───────────────────────────────────────────
# Set RATE_LIMIT_ENABLED=0 to disable (not recommended in production).
# Limits are "max requests per window(seconds)" keyed by user/IP.
RATE_LIMIT_ENABLED=1
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_AUTH_WINDOW=60
RATE_LIMIT_EXPENSIVE_MAX=20
RATE_LIMIT_EXPENSIVE_WINDOW=60
RATE_LIMIT_API_MAX=120
RATE_LIMIT_API_WINDOW=60
RATE_LIMIT_DEFAULT_MAX=300
RATE_LIMIT_DEFAULT_WINDOW=60
# Reject request bodies larger than this many bytes (default 12 MB).
MAX_REQUEST_BODY_BYTES=12582912

# ── Superadmin song preview fetch (YouTube → chorus clip) ─────────────────────
# Render/datacenter IPs often get "Sign in to confirm you're not a bot" without cookies.
# Export Netscape cookies while signed into YouTube in Chrome/Firefox, then base64 the file:
#   macOS/Linux: base64 -i youtube_cookies.txt | pbcopy
# Set the result on Render as YTDLP_COOKIES_B64 (Environment → Secret).
# Local dev can instead point at the file:
# YTDLP_COOKIES_FILE=/path/to/youtube_cookies.txt
# Export with a browser extension (e.g. "Get cookies.txt LOCALLY") or:
#   yt-dlp --cookies-from-browser chrome --cookies youtube_cookies.txt --skip-download "https://youtube.com"
# YTDLP_COOKIES_B64=

# ── Setup checklist ───────────────────────────────────────────────────────────
# 1. Enable Email provider: Authentication → Providers → Email
# 2. Run SQL migrations in order:
#    - supabase/migrations/202506100001_profiles.sql
#    - supabase/migrations/202506100002_rls_hardening.sql
#    - supabase/migrations/202506100003_church_on_signup.sql
#    - supabase/migrations/202506100004_security_hardening.sql
#    - supabase/migrations/202506100005_backfill_church_profiles.sql
#    - supabase/migrations/202506100006_parish_membership.sql
#    - supabase/migrations/202506100007_logo_lock.sql
#    - supabase/migrations/202506100008_role_security.sql
#    - supabase/migrations/202506100009_security_rpc_hardening.sql
#    - supabase/migrations/202506100010_drop_clerk_user_id.sql
#    - supabase/migrations/202506100011_membership_lock_guards.sql
# 3. Set SUPERADMIN_EMAILS in .env — bootstraps profiles.role=superadmin on server start
# 4. Restart server and visit /sign-up to create an account
# 4. NOTE: in-process rate limiting assumes a single app instance. For multiple
#    instances/workers, front the app with a shared limiter (Cloudflare, or a
#    Redis-backed limiter) so limits are global.
